---
interface Props {
  background?: 'base' | 'surface-2';
  bordered?: boolean;
  size?: 'default' | 'lg';
  id?: string;
}

const {
  background = 'base',
  bordered = false,
  size = 'default',
  id,
} = Astro.props;
---

<section
  id={id}
  class:list={['band', `bg-${background}`, { bordered }]}
>
  <div class:list={['inner', `size-${size}`]}>
    <slot />
  </div>
</section>

<style>
  .band {
    background: var(--bg);
  }

  .bg-surface-2 {
    background: var(--surface-2);
  }

  .bordered {
    border-top: var(--border-width) solid var(--line);
  }

  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--section-y) var(--pad-x) var(--section-y-end);
  }

  .size-lg {
    padding-block: var(--section-y-lg) var(--section-y-lg-end);
  }
</style>
