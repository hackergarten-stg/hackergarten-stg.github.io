---
import { externalAttrs } from './external';

interface Props {
  href: string;
  variant?: 'solid' | 'outline' | 'inverse';
  arrow?: boolean;
  external?: boolean;
  /** Fill the width of the container, centring the label. */
  block?: boolean;
}

const {
  href,
  variant = 'solid',
  arrow = true,
  external = true,
  block = false,
} = Astro.props;
---

<a
  href={href}
  class:list={['button', variant, { block }]}
  {...externalAttrs(external)}
>
  <slot />
  {arrow && <span class="arrow" aria-hidden="true">→</span>}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-tight);
    border-radius: var(--radius-btn);
    font-size: var(--fs-base);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    white-space: nowrap;
    border: var(--border-width) solid transparent;
    transition:
      filter var(--duration) ease,
      background var(--duration) ease,
      color var(--duration) ease;
  }

  .button:hover {
    text-decoration: none;
  }

  .block {
    width: 100%;
    justify-content: center;
  }

  .arrow {
    font-family: var(--font-mono);
  }

  .solid {
    background: var(--accent-fill);
    color: var(--on-accent);
    padding: var(--button-pad);
  }

  .solid:hover {
    filter: brightness(var(--hover-brightness));
  }

  .inverse {
    background: var(--inverse-fill);
    color: var(--on-inverse);
    padding: var(--button-pad-sm);
  }

  .inverse:hover {
    filter: brightness(var(--hover-dim));
  }

  .outline {
    border-color: var(--line-strong);
    color: var(--fg);
    padding: var(--button-pad-sm);
  }

  .outline:hover {
    border-color: var(--accent-fill);
    background: var(--accent-fill);
    color: var(--on-accent);
  }
</style>
