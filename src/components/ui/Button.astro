---
interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  arrow?: boolean;
  external?: boolean;
}

const { href, variant = 'solid', arrow = true, external = true } = Astro.props;
---

<a
  href={href}
  class:list={['button', variant]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <slot />
  {arrow && <span class="arrow" aria-hidden="true">→</span>}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: var(--radius-btn);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      filter 0.15s ease,
      background 0.15s ease,
      color 0.15s ease;
  }

  .button:hover {
    text-decoration: none;
  }

  .arrow {
    font-family: var(--font-mono);
  }

  .solid {
    background: var(--accent);
    color: var(--bg);
    padding: 14px 22px;
    font-size: var(--fs-md);
  }

  .solid:hover {
    filter: brightness(1.08);
  }

  .outline {
    border-color: var(--accent);
    color: var(--accent);
    padding: 10px 18px;
    border-radius: 9px;
    font-size: var(--fs-base);
  }

  .outline:hover {
    background: var(--accent);
    color: var(--bg);
  }
</style>
