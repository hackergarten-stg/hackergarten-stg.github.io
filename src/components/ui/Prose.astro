---
/** Styles rendered markdown. Everything inside is author-written content. */
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    font-size: var(--fs-lg);
    line-height: var(--lh-prose);
    color: var(--fg);
    max-width: var(--measure-prose);
  }

  .prose > * + * {
    margin-top: var(--prose-flow);
  }

  .prose h2,
  .prose h3 {
    margin-top: var(--prose-heading-gap);
    line-height: var(--lh-snug);
  }

  .prose h2 {
    font-size: var(--fs-2xl);
  }

  .prose h3 {
    font-size: var(--fs-xl);
  }

  .prose p,
  .prose li {
    text-wrap: pretty;
  }

  .prose ul,
  .prose ol {
    padding-left: var(--prose-list-indent);
    list-style: revert;
  }

  .prose li + li {
    margin-top: var(--prose-item-gap);
  }

  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: var(--prose-code-size);
    background: var(--surface-2);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-sm);
    padding: var(--prose-code-pad);
  }

  .prose pre {
    background: var(--surface-2);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    overflow-x: auto;
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }

  .prose pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }

  .prose blockquote {
    border-left: var(--border-width-thick) solid var(--accent);
    padding-left: var(--space-4);
    color: var(--muted);
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: var(--border-width) solid var(--line);
  }

  .prose hr {
    border: 0;
    border-top: var(--border-width) solid var(--line);
  }
</style>
