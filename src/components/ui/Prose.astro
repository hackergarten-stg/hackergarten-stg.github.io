---
/** Styles rendered markdown. Everything inside is author-written content. */
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    font-size: var(--fs-lg);
    line-height: 1.7;
    color: var(--fg);
    max-width: 68ch;
  }

  .prose > * + * {
    margin-top: 1.1em;
  }

  .prose h2,
  .prose h3 {
    margin-top: 2em;
    line-height: 1.25;
  }

  .prose h2 {
    font-size: var(--fs-2xl);
  }

  .prose h3 {
    font-size: var(--fs-xl);
  }

  .prose p,
  .prose li {
    text-wrap: pretty;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.3em;
    list-style: revert;
  }

  .prose li + li {
    margin-top: 0.4em;
  }

  .prose a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.35em;
  }

  .prose pre {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    padding: 20px;
    overflow-x: auto;
    font-size: var(--fs-base);
    line-height: 1.6;
  }

  .prose pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: inherit;
  }

  .prose blockquote {
    border-left: 2px solid var(--accent);
    padding-left: 18px;
    color: var(--muted);
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    border: 1px solid var(--line);
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
  }
</style>
