---
interface Props {
  as?: 'article' | 'a' | 'div';
  href?: string;
  interactive?: boolean;
  shadow?: boolean;
  size?: 'sm' | 'md';
  external?: boolean;
}

const {
  as: Tag = 'article',
  href,
  interactive = false,
  shadow = true,
  size = 'md',
  external = true,
} = Astro.props;

const isLink = Tag === 'a';
---

<Tag
  href={isLink ? href : undefined}
  target={isLink && external ? '_blank' : undefined}
  rel={isLink && external ? 'noopener noreferrer' : undefined}
  class:list={['card', size, { interactive, shadow, link: isLink }]}
>
  <slot />
</Tag>

<style>
  .card {
    background: var(--surface);
    border: var(--border-width) solid var(--line);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
  }

  .sm {
    padding: var(--card-pad-sm);
    gap: var(--card-gap-sm);
  }

  .md {
    padding: var(--card-pad);
    gap: var(--card-gap);
  }

  .shadow {
    box-shadow: var(--shadow);
  }

  .link {
    color: var(--fg);
    text-decoration: none;
  }

  .link:hover {
    text-decoration: none;
  }

  .interactive {
    transition: border-color var(--duration) ease;
  }

  .interactive:hover {
    border-color: var(--accent);
  }
</style>
