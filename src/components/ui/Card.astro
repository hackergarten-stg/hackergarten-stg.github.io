---
import { externalAttrs } from './external';

interface Props {
  as?: 'article' | 'a' | 'div';
  href?: string;
  interactive?: boolean;
  shadow?: boolean;
  size?: 'sm' | 'md';
  external?: boolean;
  /** On tablets, where the card spans the full width, lay out its two children side by side, aligned as given. */
  split?: 'top' | 'center';
}

const {
  as: Tag = 'article',
  href,
  interactive = false,
  shadow = true,
  size = 'md',
  external = true,
  split,
} = Astro.props;

const isLink = Tag === 'a';
---

<Tag
  href={isLink ? href : undefined}
  {...externalAttrs(isLink && external)}
  class:list={[
    'card',
    size,
    split && ['split', `split-${split}`],
    { interactive, shadow, link: isLink },
  ]}
>
  <slot />
</Tag>

<style>
  .card {
    background: var(--surface);
    border: var(--border-width) solid var(--line);
    border-top: var(--border-width-accent) solid var(--accent-fill);
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
  }

  .sm {
    padding: var(--card-pad-sm);
    gap: var(--card-gap-sm);
  }

  .md {
    padding: var(--card-pad);
    gap: var(--card-gap);
  }

  @media (--tablet-only) {
    .split {
      display: grid;
      grid-template-columns: var(--row-tracks);
      gap: var(--gap-loose);
    }

    .split-top {
      align-items: start;
    }

    .split-center {
      align-items: center;
    }
  }

  .shadow {
    box-shadow: var(--shadow);
  }

  .link {
    color: var(--fg);
    text-decoration: none;
  }

  .link:hover {
    text-decoration: none;
  }

  .interactive {
    transition: border-color var(--duration) ease;
  }

  .interactive:hover {
    border-color: var(--accent-fill);
  }
</style>
