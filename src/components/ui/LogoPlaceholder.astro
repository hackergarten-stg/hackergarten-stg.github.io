---
interface Props {
  label: string;
  /** Drop real logo files into `public/sponsors/` and pass e.g. `/sponsors/codecentric.svg`. */
  src?: string;
}

const { label, src } = Astro.props;
---

<div class="slot">
  {
    src ? (
      <img src={src} alt={label} class="logo" />
    ) : (
      <span class="placeholder">{label}</span>
    )
  }
</div>

<style>
  .slot {
    height: 64px;
    filter: var(--sponsor-filter);
    display: flex;
    align-items: center;
  }

  .logo {
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    border: 1px dashed var(--line);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-mono);
    text-align: center;
    color: var(--muted);
  }
</style>
