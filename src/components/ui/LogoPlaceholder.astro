---
interface Props {
  label: string;
  /** Drop real logo files into `public/sponsors/` and pass e.g. `/sponsors/codecentric.svg`. */
  src?: string;
  /** Optional variant shown instead of `src` in dark mode. */
  srcDark?: string;
}

const { label, src, srcDark } = Astro.props;
---

<div class="slot">
  {
    src ? (
      <>
        <img src={src} alt={label} class:list={['logo', { 'logo--light': srcDark }]} />
        {srcDark && <img src={srcDark} alt={label} class="logo logo--dark" />}
      </>
    ) : (
      <span class="placeholder">{label}</span>
    )
  }
</div>

<style>
  .slot {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo {
    max-height: 100%;
    max-width: 100%;
    width: auto;
    object-fit: contain;
  }

  .logo--dark {
    display: none;
  }

  :global([data-theme='dark']) .logo--light {
    display: none;
  }

  :global([data-theme='dark']) .logo--dark {
    display: block;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    border: 1px dashed var(--line);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-mono);
    text-align: center;
    color: var(--muted);
  }
</style>
