---
import Card from '../ui/Card.astro';
import LogoPlaceholder from '../ui/LogoPlaceholder.astro';

interface Props {
  href: string;
  name: string;
  description: string;
  logo?: string;
  logoDark?: string;
}

const { href, name, description, logo, logoDark } = Astro.props;
---

<Card as="a" href={href} interactive shadow={false} size="sm" split="center">
  <LogoPlaceholder label={name} src={logo} srcDark={logoDark} />
  <div class="text">
    <span class="name">{name}</span>
    <span class="description">{description}</span>
  </div>
</Card>

<style>
  .text {
    display: flex;
    flex-direction: column;
    gap: var(--gap-tight);
  }

  .name {
    font-size: var(--fs-lg);
    font-weight: var(--weight-semibold);
  }

  .description {
    font-size: var(--fs-base);
    line-height: var(--lh-body);
    color: var(--muted);
  }
</style>
