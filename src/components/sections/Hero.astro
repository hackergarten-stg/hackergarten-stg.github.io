---
import { links } from '../../config/site';
import { t, type Lang } from '../../i18n/ui';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Section size="lg">
  <Eyebrow>{t(lang, 'hero.eyebrow')}</Eyebrow>
  <h1 class="title">
    {t(lang, 'hero.title')}<span class="cursor" aria-hidden="true">_</span>
  </h1>
  <p class="subline">{t(lang, 'hero.subline')}</p>
  <div class="actions">
    <Button href={links.meetup}>{t(lang, 'hero.cta')}</Button>
    <span class="meta">{t(lang, 'hero.meta')}</span>
  </div>
</Section>

<style>
  .title {
    margin: var(--space-5) 0 var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--fs-h1);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-tight);
    max-width: var(--measure-xs);
  }

  .cursor {
    color: var(--signal-fill);
    animation: blink var(--duration-blink) steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }

  .subline {
    margin: 0 0 var(--space-8);
    font-size: var(--fs-xl);
    line-height: var(--lh-body);
    color: var(--muted);
    max-width: var(--measure-lg);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--muted);
  }
</style>
