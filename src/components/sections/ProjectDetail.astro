---
import { render, type CollectionEntry } from 'astro:content';
import { formatDate, getLocalePath, t, type Lang } from '../../i18n/ui';
import ExternalLink from '../ui/ExternalLink.astro';
import Prose from '../ui/Prose.astro';
import Section from '../ui/Section.astro';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
}

const { lang, project } = Astro.props;
const { title, date, summary, repo } = project.data;
const { Content } = await render(project);
---

<Section size="lg">
  <a class="back" href={getLocalePath(lang, '/projects')}>
    <span aria-hidden="true">←</span>
    {t(lang, 'projects.back')}
  </a>

  <header class="header">
    <time class="date" datetime={date.toISOString().slice(0, 10)}>
      {formatDate(lang, date)}
    </time>
    <h1 class="title">{title}</h1>
    <p class="summary">{summary}</p>
  </header>

  <Prose>
    <Content />
  </Prose>

  {
    repo && (
      <p class="repo">
        <ExternalLink href={repo} hint>
          {t(lang, 'projects.repo')}
        </ExternalLink>
      </p>
    )
  }
</Section>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-tight);
    font-size: var(--fs-base);
    font-weight: var(--weight-medium);
    color: var(--muted);
  }

  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .header {
    margin: var(--space-6) 0 var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    max-width: var(--measure-md);
  }

  .date {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    letter-spacing: var(--tracking-mono);
    color: var(--accent);
  }

  .title {
    margin: 0;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
  }

  .summary {
    margin: 0;
    font-size: var(--fs-lg);
    line-height: var(--lh-body);
    color: var(--muted);
    text-wrap: pretty;
  }

  .repo {
    margin: var(--space-12) 0 0;
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--line);
    font-size: var(--fs-md);
    font-weight: var(--weight-medium);
  }
</style>
