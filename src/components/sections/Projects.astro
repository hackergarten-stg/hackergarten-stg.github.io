---
import { getCollection } from 'astro:content';
import { formatDate, getLocalePath, t, type Lang } from '../../i18n/ui';
import Card from '../ui/Card.astro';
import Grid from '../ui/Grid.astro';
import Section from '../ui/Section.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Section size="lg">
  <SectionHeading
    as="h1"
    title={t(lang, 'projects.title')}
    intro={t(lang, 'projects.intro')}
  />
  <Grid columns="auto">
    {
      projects.map(({ id, data }) => (
        <Card
          as="a"
          href={getLocalePath(lang, `/projects/${id}`)}
          external={false}
          interactive
        >
          <time class="date" datetime={data.date.toISOString().slice(0, 10)}>
            {formatDate(lang, data.date)}
          </time>
          <h2 class="title">{data.title}</h2>
          <p class="summary">{data.summary}</p>
        </Card>
      ))
    }
  </Grid>
</Section>

<style>
  .date {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-mono);
    color: var(--accent);
  }

  .title {
    margin: 0;
    font-size: var(--fs-2xl);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
  }

  .summary {
    margin: 0;
    font-size: var(--fs-md);
    line-height: var(--lh-body);
    color: var(--muted);
    text-wrap: pretty;
  }
</style>
