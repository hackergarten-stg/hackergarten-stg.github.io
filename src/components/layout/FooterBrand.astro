---
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="column">
  <span class="made">
    {t(lang, 'footer.madePrefix')}
    <span class="heart" aria-hidden="true">♥</span>
    {t(lang, 'footer.madeSuffix')}
    <svg
      width="18"
      height="12"
      viewBox="0 0 18 12"
      role="img"
      aria-label={t(lang, 'footer.flag')}
      class="flag"
    >
      <rect width="18" height="4" y="0" fill="#000000"></rect>
      <rect width="18" height="4" y="4" fill="#DD0000"></rect>
      <rect width="18" height="4" y="8" fill="#FFCE00"></rect>
    </svg>
  </span>
  <span class="tagline">{t(lang, 'footer.tagline')}</span>
</div>

<style>
  .column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .made {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-md);
    font-weight: 500;
  }

  .heart {
    color: var(--accent);
  }

  .flag {
    border-radius: 2px;
    margin-left: 4px;
  }

  .tagline {
    font-size: var(--fs-base);
    line-height: 1.6;
    color: var(--muted);
  }
</style>
