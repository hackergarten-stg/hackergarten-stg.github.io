---
import { communityLinks } from '../../config/site';
import { t, type Lang } from '../../i18n/ui';
import ExternalLink from '../ui/ExternalLink.astro';
import Grid from '../ui/Grid.astro';
import FooterBrand from './FooterBrand.astro';
import FooterColumn from './FooterColumn.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="columns">
    <Grid collapse="mobile" gap="section">
      <FooterBrand lang={lang} />

      <FooterColumn title={t(lang, 'footer.whenWhere')}>
        <span>{t(lang, 'footer.when')}</span>
        <span class="muted">
          {t(lang, 'footer.venueName')}<br />{t(lang, 'footer.venueAddress')}
        </span>
      </FooterColumn>

      <FooterColumn title={t(lang, 'footer.community')}>
        {
          communityLinks.map(({ href, label }) => (
            <ExternalLink href={href}>{label}</ExternalLink>
          ))
        }
      </FooterColumn>
    </Grid>
  </div>

  <div class="baseline">
    <span class="copyright">
      © {year} Hackergarten Stuttgart · {t(lang, 'footer.bring')}
    </span>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-width) solid var(--line);
    background: var(--surface-2);
  }

  .columns {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-14) var(--pad-x) var(--gap-section);
  }

  .baseline {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--pad-x) var(--gap-section);
  }

  .copyright {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--muted);
  }

  .muted {
    color: var(--muted);
  }
</style>
