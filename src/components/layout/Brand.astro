---
import { getLocalePath, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<a href={getLocalePath(lang, '/')} class="brand">
  <span class="mark" aria-hidden="true">HG</span>
  <span class="wordmark">{t(lang, 'nav.brand')}</span>
</a>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: var(--gap);
    color: var(--fg);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .mark {
    width: var(--control-size);
    height: var(--control-size);
    flex-shrink: 0;
    border-radius: var(--radius-btn);
    background: var(--accent);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-tight);
  }

  .wordmark {
    font-size: var(--fs-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }
</style>
