---
import { getLocalePath, t, type Lang } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<a href={getLocalePath(lang, "/")} class="brand">
  <span class="mark" aria-hidden="true"><img src="/icon.svg" alt="" /></span>
  <span class="wordmark">{t(lang, "nav.brand")}</span>
</a>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--fg);
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .mark {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: var(--radius-btn);
    background: var(--accent);
    color: var(--bg);
    display: grid;
    place-items: center;
  }

  .wordmark {
    font-size: var(--fs-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
</style>
