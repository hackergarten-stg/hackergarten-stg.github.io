---
import { navRoutes } from '../../config/site';
import { getLocalePath, t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  route: string;
}

const { lang, route } = Astro.props;
---

<nav class="nav">
  {
    navRoutes.map(({ path, labelKey }) => {
      // Sub-routes keep their section highlighted, e.g. /projects/jqwik.
      const active =
        path === '/' ? route === '/' : route === path || route.startsWith(`${path}/`);
      return (
        <a
          href={getLocalePath(lang, path)}
          class:list={['link', { active }]}
          aria-current={active ? 'page' : undefined}
        >
          {t(lang, labelKey)}
        </a>
      );
    })
  }
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: var(--gap-loose);
    font-size: var(--fs-base);
    font-weight: var(--weight-medium);
  }

  .link {
    color: var(--muted);
    text-decoration: none;
    padding-bottom: var(--space-0-5);
    border-bottom: var(--border-width-thick) solid transparent;
    transition: color var(--duration) ease;
  }

  .link:hover {
    color: var(--fg);
    text-decoration: none;
  }

  .active {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }
</style>
